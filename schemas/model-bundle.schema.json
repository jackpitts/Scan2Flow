{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jackpitts/Scan2Flow/schemas/model-bundle.schema.json",
  "title": "Proposed Scan2Flow model artifact bundle manifest",
  "description": "A planning contract, not an implemented artifact loader. Paths are relative to the immutable bundle root.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "architecture", "code_revision", "dataset_version", "dataset_sha256", "config_sha256", "seed", "preprocessing_version", "supported_modalities", "artifacts", "promotion_status"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "model_id": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "minLength": 1},
    "code_revision": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"},
    "dataset_version": {"type": "string", "minLength": 1},
    "dataset_sha256": {"$ref": "#/$defs/hash"},
    "config_sha256": {"$ref": "#/$defs/hash"},
    "seed": {"type": "integer", "minimum": 0},
    "preprocessing_version": {"type": "string", "minLength": 1},
    "supported_modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["photo", "video", "lidar"]}},
    "promotion_status": {"enum": ["candidate", "approved", "rejected", "retired"]},
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["weights", "training_config", "preprocessing", "environment", "evaluation", "model_card"],
      "properties": {
        "weights": {"$ref": "#/$defs/file"},
        "training_config": {"$ref": "#/$defs/file"},
        "preprocessing": {"$ref": "#/$defs/file"},
        "environment": {"$ref": "#/$defs/file"},
        "evaluation": {"$ref": "#/$defs/file"},
        "model_card": {"$ref": "#/$defs/file"},
        "optimizer_state": {"$ref": "#/$defs/file"},
        "rng_state": {"$ref": "#/$defs/file"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "format": {"type": "string", "minLength": 1}
      }
    }
  }
}
