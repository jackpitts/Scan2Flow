{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jackpitts/Scan2Flow/schemas/dataset-record.schema.json",
  "title": "Proposed Scan2Flow dataset JSONL record",
  "description": "One object capture and its CAD target. Asset existence, units, rights, checksums, grouping, and calibration require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "object_id", "family_id", "capture_session", "split", "modality", "inputs", "cad_target", "length_unit", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "dataset_version": {"type": "string", "minLength": 1},
    "object_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "capture_session": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "test"]},
    "modality": {"enum": ["photo", "video", "lidar"]},
    "inputs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "sensor_id"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "sensor_id": {"type": "string", "minLength": 1},
          "timestamp_utc": {"type": "string", "format": "date-time"}
        }
      }
    },
    "cad_target": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "feature_annotations": {"$ref": "#/$defs/path"},
        "world_from_cad": {"$ref": "#/$defs/matrix4"}
      }
    },
    "length_unit": {"enum": ["m", "cm", "mm"]},
    "known_length": {"type": "number", "exclusiveMinimum": 0},
    "calibration": {"$ref": "#/$defs/path"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "license", "rights_holder"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "rights_holder": {"type": "string", "minLength": 1},
        "sensor_model": {"type": "string", "minLength": 1},
        "parent_object_id": {"type": "string", "minLength": 1},
        "synthetic": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "slices": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "occlusion": {"enum": ["low", "medium", "high", "unknown"]},
        "material": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "description": "Relative to the manifest directory. A future loader must check resolved paths against an explicit authorized dataset root, reject unapproved escapes or absolute paths, and check file existence."},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "matrix4": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/row4"}, {"$ref": "#/$defs/row4"}, {"$ref": "#/$defs/row4"},
        {"const": [0, 0, 0, 1]}
      ],
      "items": false,
      "description": "Row-major world-from-CAD rigid transform applied after converting CAD coordinates to metres. Identity is assumed only when target alignment is verified."
    },
    "row4": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
  }
}
