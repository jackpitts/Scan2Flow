{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jackpitts/Scan2Flow/schemas/calibration.schema.json",
  "title": "Proposed Scan2Flow calibration contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "translation_unit", "world_frame", "scale_status", "sensors"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "translation_unit": {"const": "m"},
    "world_frame": {"const": "right_handed_z_up"},
    "scale_status": {"enum": ["measured", "assumed"]},
    "scale_source": {"type": "string", "minLength": 1},
    "sensors": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sensor"}
    },
    "frame_poses": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["input_path", "timestamp_s", "sensor_id", "world_from_sensor"],
        "properties": {
          "input_path": {"type": "string", "minLength": 1},
          "timestamp_s": {"type": "number", "minimum": 0},
          "sensor_id": {"type": "string", "minLength": 1},
          "world_from_sensor": {"$ref": "#/$defs/matrix4"}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"scale_status": {"const": "measured"}}}, "then": {"required": ["scale_source"]}}
  ],
  "$defs": {
    "sensor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "world_from_sensor"],
      "properties": {
        "kind": {"enum": ["camera", "lidar"]},
        "world_from_sensor": {"$ref": "#/$defs/matrix4"},
        "image_size_px": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
        "camera_axes": {"const": "x_right_y_down_z_forward"},
        "intrinsics": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "prefixItems": [
            {"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0},
            {"type": "number"}, {"type": "number"}
          ], "items": false
        },
        "distortion_model": {"enum": ["none", "brown_conrady_5"]},
        "distortion_coefficients": {"type": "array", "items": {"type": "number"}},
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "camera"}}},
          "then": {"required": ["image_size_px", "camera_axes", "intrinsics", "distortion_model", "distortion_coefficients"]}
        },
        {
          "if": {"required": ["distortion_model"], "properties": {"distortion_model": {"const": "none"}}},
          "then": {"properties": {"distortion_coefficients": {"maxItems": 0}}}
        },
        {
          "if": {"required": ["distortion_model"], "properties": {"distortion_model": {"const": "brown_conrady_5"}}},
          "then": {"properties": {"distortion_coefficients": {"minItems": 5, "maxItems": 5}}}
        }
      ]
    },
    "matrix4": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/row4"}, {"$ref": "#/$defs/row4"}, {"$ref": "#/$defs/row4"},
        {"const": [0, 0, 0, 1]}
      ], "items": false
    },
    "row4": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
  }
}
